+
+package com.cyanogenmod.lockclock.weather;
+
+import android.content.Context;
+import android.location.Location;
+import android.net.Uri;
+import android.text.TextUtils;
+import android.util.Log;
+
+import com.cyanogenmod.lockclock.R;
+import com.cyanogenmod.lockclock.misc.Preferences;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+public class OpenMeteoWeatherProvider implements WeatherProvider {
+    private static final String TAG = "OpenMeteoWeatherProvider";
+    private static final String GEOCODING_URL =
+            "https://geocoding-api.open-meteo.com/v1/search?name=%s&count=10&language=%s";
+    private static final String FORECAST_URL =
+            "https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s"
+            + "&current=temperature_2m,relative_humidity_2m,is_day,weather_code,"
+            + "wind_speed_10m,wind_direction_10m"
+            + "&daily=temperature_2m_min,temperature_2m_max"
+            + "&temperature_unit=%s&wind_speed_unit=%s&timezone=auto&forecast_days=1";
+
+    private final Context mContext;
+
+    public OpenMeteoWeatherProvider(Context context) {
+        mContext = context.getApplicationContext();
+    }
+
+    @Override
+    public List<LocationResult> getLocations(String input) {
+        if (TextUtils.isEmpty(input)) {
+            return null;
+        }
+
+        String language = Locale.getDefault().getLanguage();
+        String url = String.format(Locale.US, GEOCODING_URL,
+                Uri.encode(input), Uri.encode(language));
+        String response = HttpRetriever.retrieve(mContext, url);
+        if (response == null) {
+            return null;
+        }
+
+        try {
+            JSONObject root = new JSONObject(response);
+            JSONArray places = root.optJSONArray("results");
+            if (places == null) {
+                return null;
+            }
+
+            ArrayList<LocationResult> locations = new ArrayList<LocationResult>();
+            for (int i = 0; i < places.length(); i++) {
+                JSONObject place = places.getJSONObject(i);
+                if (place.isNull("latitude") || place.isNull("longitude")
+                        || TextUtils.isEmpty(place.optString("name"))) {
+                    continue;
+                }
+
+                double latitude = place.getDouble("latitude");
+                double longitude = place.getDouble("longitude");
+                LocationResult result = new LocationResult();
+                result.id = coordinatesToId(latitude, longitude);
+                result.city = displayName(place);
+                result.country = place.optString("country", null);
+                result.countryId = place.optString("country_code", null);
+
+                JSONArray postcodes = place.optJSONArray("postcodes");
+                if (postcodes != null && postcodes.length() > 0
+                        && !postcodes.isNull(0)) {
+                    result.postal = postcodes.getString(0);
+                }
+                locations.add(result);
+            }
+            return locations;
+        } catch (JSONException e) {
+            Log.e(TAG, "Received malformed geocoding data", e);
+        }
+        return null;
+    }
+
+    @Override
+    public WeatherInfo getWeatherInfo(String id, String localizedCityName) {
+        double[] coordinates = parseCoordinates(id);
+        String city = localizedCityName;
+
+        // Older LockClock versions stored a Yahoo WOEID. Resolve its saved city
+        // name once, then persist the coordinate ID in the new weather cache.
+        if (coordinates == null) {
+            if (TextUtils.isEmpty(city)) {
+                return null;
+            }
+            List<LocationResult> locations = getLocations(city);
+            if (locations == null || locations.isEmpty()) {
+                return null;
+            }
+            LocationResult location = locations.get(0);
+            coordinates = parseCoordinates(location.id);
+            city = location.city;
+        }
+
+        if (TextUtils.isEmpty(city)) {
+            city = mContext.getString(R.string.weather_current_location);
+        }
+        return getWeatherInfo(coordinates[0], coordinates[1], city);
+    }
+
+    @Override
+    public WeatherInfo getWeatherInfo(Location location) {
+        if (location == null) {
+            return null;
+        }
+        return getWeatherInfo(location.getLatitude(), location.getLongitude(),
+                mContext.getString(R.string.weather_current_location));
+    }
+
+    private WeatherInfo getWeatherInfo(double latitude, double longitude, String city) {
+        boolean metric = Preferences.useMetricUnits(mContext);
+        String temperatureUnit = metric ? "celsius" : "fahrenheit";
+        String windUnit = metric ? "kmh" : "mph";
+        String url = String.format(Locale.US, FORECAST_URL,
+                formatCoordinate(latitude), formatCoordinate(longitude),
+                temperatureUnit, windUnit);
+        String response = HttpRetriever.retrieve(mContext, url);
+        if (response == null) {
+            return null;
+        }
+
+        try {
+            JSONObject root = new JSONObject(response);
+            JSONObject current = root.getJSONObject("current");
+            JSONObject daily = root.getJSONObject("daily");
+            JSONArray lows = daily.getJSONArray("temperature_2m_min");
+            JSONArray highs = daily.getJSONArray("temperature_2m_max");
+            if (lows.length() == 0 || highs.length() == 0
+                    || lows.isNull(0) || highs.isNull(0)) {
+                return null;
+            }
+
+            int weatherCode = mapWeatherCode(current.getInt("weather_code"),
+                    current.optInt("is_day", 1) == 1);
+            String id = coordinatesToId(latitude, longitude);
+            WeatherInfo info = new WeatherInfo(mContext, id, city, null,
+                    null, weatherCode,
+                    (float) current.getDouble("temperature_2m"),
+                    (float) lows.getDouble(0), (float) highs.getDouble(0),
+                    metric ? "C" : "F",
+                    (float) current.getDouble("relative_humidity_2m"),
+                    (float) current.getDouble("wind_speed_10m"),
+                    current.optInt("wind_direction_10m", -1),
+                    metric ? "km/h" : "mph",
+                    System.currentTimeMillis());
+            Preferences.setCachedLocationId(mContext, id);
+            return info;
+        } catch (JSONException e) {
+            Log.e(TAG, "Received malformed forecast data", e);
+        }
+        return null;
+    }
+
+    private static String displayName(JSONObject place) {
+        String name = place.optString("name", "");
+        String admin1 = place.optString("admin1", "");
+        if (!TextUtils.isEmpty(admin1) && !name.equalsIgnoreCase(admin1)) {
+            return name + ", " + admin1;
+        }
+        return name;
+    }
+
+    private static String coordinatesToId(double latitude, double longitude) {
+        return String.format(Locale.US, "%.4f,%.4f", latitude, longitude);
+    }
+
+    private static String formatCoordinate(double coordinate) {
+        return String.format(Locale.US, "%.4f", coordinate);
+    }
+
+    private static double[] parseCoordinates(String id) {
+        if (TextUtils.isEmpty(id)) {
+            return null;
+        }
+        String[] parts = id.split(",", 2);
+        if (parts.length != 2) {
+            return null;
+        }
+        try {
+            double latitude = Double.parseDouble(parts[0]);
+            double longitude = Double.parseDouble(parts[1]);
+            if (Double.isNaN(latitude) || Double.isInfinite(latitude)
+                    || Double.isNaN(longitude) || Double.isInfinite(longitude)
+                    || latitude < -90 || latitude > 90
+                    || longitude < -180 || longitude > 180) {
+                return null;
+            }
+            return new double[] { latitude, longitude };
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+
+    private static int mapWeatherCode(int code, boolean isDay) {
+        switch (code) {
+            case 0:
+                return isDay ? 32 : 31;
+            case 1:
+                return isDay ? 34 : 33;
+            case 2:
+                return isDay ? 30 : 29;
+            case 3:
+                return isDay ? 28 : 27;
+            case 45:
+            case 48:
+                return 20;
+            case 51:
+                return 9;
+            case 53:
+            case 55:
+                return 12;
+            case 56:
+            case 57:
+                return 8;
+            case 61:
+            case 80:
+                return 11;
+            case 63:
+            case 65:
+            case 81:
+            case 82:
+                return 12;
+            case 66:
+            case 67:
+                return 10;
+            case 71:
+            case 77:
+            case 85:
+                return 14;
+            case 73:
+            case 75:
+            case 86:
+                return 16;
+            case 95:
+                return 4;
+            case 96:
+            case 99:
+                return 17;
+            default:
+                return 3200;
+        }
+    }
+}
